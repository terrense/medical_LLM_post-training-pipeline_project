# secrets
.env
*.env
**/api_keys*

# model weights / large binaries
checkpoints/**
!checkpoints/**/.gitkeep
data/raw/**
!data/raw/**/.gitkeep
data/normalized/**
!data/normalized/**/.gitkeep
data/quarantine/**
!data/quarantine/**/.gitkeep
runs/**
!runs/**/.gitkeep
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf

# vendored third-party repo (tracked separately, not as our code)
vendor/

# raw generations / logs (large, not hand-curated results)
artifacts/logs/**
!artifacts/logs/**/.gitkeep

# human eval unblinding material must never be committed
human_eval/blind_map*
human_eval/*_UNBLINDED*

# python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# os
.DS_Store
Thumbs.db
